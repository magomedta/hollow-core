static func get_easter_egg(egg_id: String) -> Dictionary:
	return EASTER_EGGS.get(egg_id, {})

static func get_all_easter_egg_ids() -> Array:
	return EASTER_EGGS.keys()

static func get_secret_room(room_id: String) -> Dictionary:
	return SECRET_ROOMS.get(room_id, {})

static func get_all_secret_room_ids() -> Array:
	return SECRET_ROOMS.keys()
