static func get_audiolog(audio_id: String) -> Dictionary:
	return AUDIOLOGS.get(audio_id, {})

static func get_all_audiolog_ids() -> Array:
	return AUDIOLOGS.keys()

static func has_audiolog(audio_id: String) -> bool:
	return AUDIOLOGS.has(audio_id)
