; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text.

config_version=5

[application]

config/name="Hollow Core"
config/description="Subterranean Survival Sandbox in Colossal Caves"
config/version="0.1.0"
run/main_scene="res://scenes/development/m1_vertical_slice.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.015, 0.018, 0.022, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
